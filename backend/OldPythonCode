@app.post("/registration", status_code=status.HTTP_201_CREATED)
def user_register(user_details: Usermodel):
    # 1. Manually open the session
    db = Session(engine)
    try:
        # 2. CORRECT SYNTAX: Instantiate the SQLAlchemy Class (No curly braces!)
        new_user = User(
            email=user_details.email,
            firstname=user_details.firstname,
            lastname=user_details.lastname,
            password=user_details.password,  # Note: Must hash this in production
            phone=user_details.phone
        )
        # 3. Stage and save to the database
        db.add(new_user)
        db.commit()
        db.refresh(new_user) # Optional: updates 'new_user' with the ID generated by the DB
        # 4. Always return a clean JSON response
        return {
            "message": "User registered successfully!",
            "user_id": new_user.id
        }
    except Exception as e:
        # If the commit fails (e.g., duplicate email), we rollback the broken transaction
        db.rollback()
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Registration failed. Email or phone might already exist."
        )
    finally:
        # 5. GUARANTEE the connection closes, even on failure
        db.close()


